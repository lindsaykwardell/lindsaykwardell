---
import BaseLayout from '@/layouts/BaseLayout.astro'

export type PhotoCard = {
  id: string
  href: string
  url: string
  alt: string
}

interface Props {
  photos: PhotoCard[]
}

const { photos } = Astro.props
---

<BaseLayout>
  <div class="photo-grid columns-2 md:columns-3 gap-2 p-1">
    {
      photos.map((photo) => (
        <a href={photo.href} class="mb-2 block">
          <img
            src={photo.url}
            alt={photo.alt}
            class="rounded transition-opacity duration-300"
            loading="lazy"
          />
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  .photo-grid:hover img {
    opacity: 0.6;
  }
  .photo-grid a:hover img {
    opacity: 1;
  }
</style>
