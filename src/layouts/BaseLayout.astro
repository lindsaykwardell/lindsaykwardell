---
import Header from '@/components/Header.astro'
import details from '@/content/details/index.json'

import '@fontsource-variable/baloo-bhaina-2'
import '@fontsource/philosopher'
import '@/styles/main.css'
import { ClientRouter } from 'astro:transitions'

interface Props {
  title?: string
  description?: string
  image?: string
  permalink?: string
  hideHeader?: boolean
  fullScreen?: boolean
  /** site.standard.document AT-URI for verification */
  documentAtUri?: string | null
  /** site.standard.publication AT-URI for verification */
  publicationAtUri?: string | null
}

let {
  title,
  description,
  image,
  permalink,
  hideHeader,
  fullScreen,
  documentAtUri,
  publicationAtUri,
} = Astro.props

title = title || details.title
description = description || details.description
image = image
  ? image.includes('http')
    ? image
    : details.permalink + image
  : details.image
permalink = permalink ? details.permalink + permalink : details.permalink
---

<html lang="en">
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Lindsay Wardell" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={permalink} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={permalink} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={details.title}
      href={new URL('rss.xml', details.permalink)}
    />

    <!-- Webmention / IndieWeb -->
    <link
      rel="webmention"
      href="https://webmention.io/lindsaykwardell.com/webmention"
    />
    <link
      rel="pingback"
      href="https://webmention.io/lindsaykwardell.com/xmlrpc"
    />
    <meta name="fediverse:creator" content="@lindsaykwardell@mastodon.social" />

    {
      publicationAtUri && (
        <link rel="site.standard.publication" href={publicationAtUri} />
      )
    }
    {
      documentAtUri && (
        <link rel="site.standard.document" href={documentAtUri} />
      )
    }

    <!-- Bluesky comments -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/bluesky-comments@latest/dist/bluesky-comments.css"
    />

    <slot name="head" />

    <ClientRouter />
  </head>

  <body>
    <div
      class="bg-gradient-to-br from-accent via-background to-background h-[75px] w-full absolute top-0 left-0"
    >
    </div>
    {!hideHeader && <Header />}

    <main
      class=`${fullScreen ? '' : 'max-w-[1000px] m-auto '}pt-12 md:pb-4 md:px-7`
    >
      <slot />
    </main>

    <script
      data-goatcounter="https://lindsaykwardell.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
