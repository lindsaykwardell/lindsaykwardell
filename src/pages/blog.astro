---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ReadingIssue from '@/components/ReadingIssue.astro'
import PhotosArchive from '@/components/PhotosArchive.astro'
import TypeArchive from '@/components/TypeArchive.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { getPublicationUri } from '@/lib/standard-site'
import { readingPostHref } from '@/lib/reading'

type Post = CollectionEntry<'blog'>

const WRITING_TYPES = new Set(['Personal', 'Blog', 'Programming', 'Fiction'])

const TYPE_ORDER = [
  'Personal',
  'Programming',
  'Poetry',
  'Fiction',
  'Photo',
  'Podcast',
  'Video',
  'Meetup',
  'Conference',
]

const rawTypeFilter = Astro.url.searchParams.get('type')
// ?type=Blog still works (renamed to Personal)
const typeFilter =
  rawTypeFilter === 'Blog' ? 'Personal' : rawTypeFilter
const publicationAtUri = getPublicationUri()

const allPosts = (await getCollection('blog'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((post) => {
    if (post.data.type === 'Blog') {
      return { ...post, data: { ...post.data, type: 'Personal' } }
    }
    return post
  })

const typeCounts = allPosts.reduce(
  (acc, post) => {
    const t = post.data.type || 'Personal'
    acc[t] = (acc[t] || 0) + 1
    return acc
  },
  {} as Record<string, number>,
)

const browseTypes = TYPE_ORDER.filter((t) => typeCounts[t]).concat(
  Object.keys(typeCounts).filter((t) => !TYPE_ORDER.includes(t)),
)

const filtered = typeFilter
  ? allPosts.filter((post) => post.data.type === typeFilter)
  : []

const filteredByYear = filtered.reduce(
  (byYear, post) => {
    const year = post.data.pubDate.getFullYear().toString()
    if (!byYear[year]) byYear[year] = []
    byYear[year].push(post)
    return byYear
  },
  {} as Record<string, Post[]>,
)

const lead = allPosts.find((p) => WRITING_TYPES.has(p.data.type || ''))

const recentWriting = allPosts
  .filter(
    (p) =>
      WRITING_TYPES.has(p.data.type || '') && (!lead || p.id !== lead.id),
  )
  .slice(0, 5)

const photoArchive =
  typeFilter === 'Photo'
    ? filtered
        .filter((post) => post.data.image && post.data.image !== 'null')
        .map((post) => ({
          id: post.id,
          href: readingPostHref(post.id, 'Photo'),
          url: post.data.image!,
          alt: post.data.snippet || post.data.title,
        }))
    : []

const archiveTitle = typeFilter === 'Photo' ? 'Photos' : typeFilter
const pageTitle = typeFilter
  ? `${archiveTitle} — Lindsay Wardell`
  : 'Reading — Lindsay Wardell'
---

<BaseLayout
  title={pageTitle}
  description="Essays, poetry, photos, and appearances by Lindsay Wardell."
  publicationAtUri={publicationAtUri}
>
  {
    typeFilter === 'Photo' ? (
      <PhotosArchive photos={photoArchive} count={filtered.length} />
    ) : typeFilter ? (
      <TypeArchive
        type={typeFilter}
        postsByYear={filteredByYear}
        count={filtered.length}
      />
    ) : (
      <ReadingIssue
        lead={lead}
        recentWriting={recentWriting}
        browseTypes={browseTypes}
        typeCounts={typeCounts}
      />
    )
  }
</BaseLayout>
