---
/**
 * /blog — a reading issue: featured pieces by kind, short shelves, browse by type.
 * ?type= falls back to a denser archive for that kind.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Badge from '@/components/Badge.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { getPublicationUri } from '@/lib/standard-site'

type Post = CollectionEntry<'blog'>

const WRITING_TYPES = new Set(['Personal', 'Blog', 'Programming', 'Fiction'])
const APPEARANCE_TYPES = new Set(['Podcast', 'Video', 'Meetup', 'Conference'])

const TYPE_ORDER = [
  'Personal',
  'Programming',
  'Poetry',
  'Fiction',
  'Photo',
  'Podcast',
  'Video',
  'Meetup',
  'Conference',
]

const rawTypeFilter = Astro.url.searchParams.get('type')
/** Old ?type=Blog bookmarks still work. */
const typeFilter =
  rawTypeFilter === 'Blog' ? 'Personal' : rawTypeFilter
const publicationAtUri = getPublicationUri()

const allPosts = (await getCollection('blog'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((post) => {
    // Normalize legacy type in-memory for display / grouping
    if (post.data.type === 'Blog') {
      return { ...post, data: { ...post.data, type: 'Personal' } }
    }
    return post
  })

const formatDate = (date: Date) =>
  Intl.DateTimeFormat('en-us', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date)

const typeCounts = allPosts.reduce(
  (acc, post) => {
    const t = post.data.type || 'Personal'
    acc[t] = (acc[t] || 0) + 1
    return acc
  },
  {} as Record<string, number>,
)

const browseTypes = TYPE_ORDER.filter((t) => typeCounts[t]).concat(
  Object.keys(typeCounts).filter((t) => !TYPE_ORDER.includes(t)),
)

// —— Filtered archive ——
const filtered = typeFilter
  ? allPosts.filter((post) => post.data.type === typeFilter)
  : []

const filteredByYear = filtered.reduce(
  (byYear, post) => {
    const year = post.data.pubDate.getFullYear().toString()
    if (!byYear[year]) byYear[year] = []
    byYear[year].push(post)
    return byYear
  },
  {} as Record<string, Post[]>,
)

// —— Issue features ——
const lead = allPosts.find((p) => WRITING_TYPES.has(p.data.type || ''))
const poems = allPosts.filter((p) => p.data.type === 'Poetry')
const poem =
  poems.length > 0
    ? poems[Math.floor(Math.random() * poems.length)]
    : undefined
const photo = allPosts.find((p) => p.data.type === 'Photo')
const appearance = allPosts.find((p) =>
  APPEARANCE_TYPES.has(p.data.type || ''),
)

const featuredIds = new Set(
  [lead, poem, photo, appearance].filter(Boolean).map((p) => p!.id),
)

const recentWriting = allPosts
  .filter((p) => WRITING_TYPES.has(p.data.type || '') && !featuredIds.has(p.id))
  .slice(0, 5)

const recentAppearances = allPosts
  .filter(
    (p) => APPEARANCE_TYPES.has(p.data.type || '') && !featuredIds.has(p.id),
  )
  .slice(0, 5)

/** Opening stanzas only — keeps poetry present without stalling the issue. */
function poemExcerpt(body: string | undefined, stanzas = 2): {
  lines: string
  truncated: boolean
} {
  const text = (body || '')
    .trim()
    // Markdown hard-break markers → real line breaks for plain display
    .replace(/\\\n/g, '\n')
  if (!text) return { lines: '', truncated: false }
  const parts = text.split(/\n\s*\n/)
  if (parts.length <= stanzas) return { lines: text, truncated: false }
  return {
    lines: parts.slice(0, stanzas).join('\n\n'),
    truncated: true,
  }
}

const poemPreview = poem ? poemExcerpt(poem.body, 4) : null
---

<BaseLayout
  title={typeFilter ? `${typeFilter} — Lindsay Wardell` : 'Reading — Lindsay Wardell'}
  description="Essays, poetry, photos, and appearances — a reading issue of Lindsay Wardell's writing."
  publicationAtUri={publicationAtUri}
>
  {
    typeFilter ? (
      <div class="blog-issue blog-issue--archive px-2 md:px-0 pb-12">
        <header class="flex flex-wrap items-baseline justify-between gap-3 pb-8 border-b border-divider/40">
          <div>
            <p class="font-title text-sm text-muted tracking-wide uppercase mb-1">
              Archive
            </p>
            <h1 class="font-title text-3xl md:text-4xl text-foreground">
              {typeFilter}
            </h1>
            <p class="text-muted mt-2 text-base">
              {filtered.length}{' '}
              {filtered.length === 1 ? 'piece' : 'pieces'}
            </p>
          </div>
          <a href="/blog" class="text-muted hover:text-hover text-sm">
            ← Reading
          </a>
        </header>

        <ul class="pt-2">
          {Object.entries(filteredByYear)
            .toSorted((a, b) => +b[0] - +a[0])
            .map(([year, posts]) => (
              <li class="pt-10">
                <h2 class="font-title text-xl text-muted mb-5">{year}</h2>
                <ul class="flex flex-col gap-6">
                  {posts.map((post) => (
                    <li
                      class:list={[
                        'grid gap-1 md:grid-cols-[1fr_auto] md:gap-x-6 md:items-baseline',
                        post.data.draft && 'italic opacity-80',
                      ]}
                    >
                      <div>
                        <a
                          href={`/blog/${post.id}`}
                          class="font-title text-xl md:text-2xl text-foreground hover:text-hover"
                          transition:name={`${post.id}-name`}
                        >
                          {post.data.title}
                          {post.data.draft ? ' (Draft)' : ''}
                        </a>
                        {post.data.snippet && (
                          <p class="text-muted mt-1 text-base leading-relaxed max-w-prose line-clamp-2">
                            {post.data.snippet}
                          </p>
                        )}
                      </div>
                      <time class="text-sm text-muted shrink-0">
                        {formatDate(post.data.pubDate)}
                      </time>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
        </ul>
      </div>
    ) : (
      <div class="blog-issue px-2 md:px-0 pb-16">
        <header class="blog-issue-masthead pb-6 md:pb-8">
          <h1 class="font-title text-3xl md:text-4xl text-foreground">
            Reading
          </h1>
        </header>

        <div class="blog-issue-top grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,18rem)] lg:gap-12 lg:items-start pb-14 md:pb-16">
          {lead && (
            <section class="blog-issue-lead" aria-labelledby="lead-title">
              <div class="flex flex-wrap items-center gap-3 text-sm text-muted mb-4">
                <span class="font-title tracking-wide uppercase text-xs">
                  Latest writing
                </span>
                <span class="text-divider/80" aria-hidden="true">
                  ·
                </span>
                <a href={`/blog?type=${lead.data.type}`}>
                  <Badge type={lead.data.type ?? 'Personal'} />
                </a>
                <time datetime={lead.data.pubDate.toISOString()}>
                  {formatDate(lead.data.pubDate)}
                </time>
              </div>

              {
                lead.data.image && lead.data.image !== 'null' && (
                  <a
                    href={`/blog/${lead.id}`}
                    class="block mb-5 -mx-2 md:mx-0 overflow-hidden"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={lead.data.image}
                      alt=""
                      class="w-full aspect-[16/9] object-cover"
                      loading="eager"
                    />
                  </a>
                )
              }

              <h2
                id="lead-title"
                class="font-title text-3xl md:text-4xl leading-tight"
              >
                <a
                  href={`/blog/${lead.id}`}
                  class="text-foreground hover:text-hover"
                  transition:name={`${lead.id}-name`}
                >
                  {lead.data.title}
                </a>
              </h2>
              {lead.data.snippet && (
                <p class="mt-3 text-lg text-muted leading-relaxed max-w-2xl">
                  {lead.data.snippet}
                </p>
              )}
              <p class="mt-4">
                <a
                  href={`/blog/${lead.id}`}
                  class="font-title text-hover hover:underline underline-offset-4"
                >
                  Read
                </a>
              </p>
            </section>
          )}

          {poem && poemPreview?.lines && (
            <aside
              class="blog-issue-poem p-4 md:p-5 hidden lg:block"
              aria-labelledby="poem-title"
            >
              <div class="flex flex-wrap items-center gap-2 text-xs text-muted mb-2">
                <span class="font-title tracking-wide uppercase">
                  A poem
                </span>
                <span class="text-divider/80" aria-hidden="true">
                  ·
                </span>
                <time datetime={poem.data.pubDate.toISOString()}>
                  {formatDate(poem.data.pubDate)}
                </time>
              </div>

              <h2 id="poem-title" class="font-title text-base mb-2">
                <a
                  href={`/blog/${poem.id}`}
                  class="text-muted hover:text-hover"
                  transition:name={`${poem.id}-name`}
                >
                  {poem.data.title}
                </a>
              </h2>

              <blockquote class="blog-issue-poem-body text-sm text-muted leading-relaxed whitespace-pre-line">
                {poemPreview.lines}
                {poemPreview.truncated && (
                  <span aria-hidden="true">
                    {'\n\n'}…
                  </span>
                )}
              </blockquote>

              <p class="blog-issue-links mt-3">
                <a
                  href={`/blog/${poem.id}`}
                  class="blog-issue-links__secondary"
                >
                  {poemPreview.truncated ? 'Continue reading' : 'Open poem'}
                </a>
                <a
                  href="/blog?type=Poetry"
                  class="blog-issue-links__secondary"
                >
                  More poetry
                </a>
              </p>
            </aside>
          )}
        </div>

        {/* Photo + appearance */}
        {(photo || appearance) && (
          <section
            class="grid md:grid-cols-2 gap-10 md:gap-12 py-14 md:py-16"
            aria-label="Photo and appearance"
          >
            {photo && (
              <div>
                <div class="flex items-center gap-3 text-sm text-muted mb-4">
                  <span class="font-title tracking-wide uppercase text-xs">
                    Latest photo
                  </span>
                  <span class="text-divider/80" aria-hidden="true">
                    ·
                  </span>
                  <time datetime={photo.data.pubDate.toISOString()}>
                    {formatDate(photo.data.pubDate)}
                  </time>
                </div>
                <a href={`/blog/${photo.id}`} class="group block">
                  {photo.data.image && (
                    <img
                      src={photo.data.image}
                      alt={photo.data.snippet || photo.data.title}
                      class="w-full aspect-square object-cover mb-4"
                      loading="lazy"
                    />
                  )}
                  <h2
                    class="font-title text-2xl text-foreground group-hover:text-hover"
                    transition:name={`${photo.id}-name`}
                  >
                    {photo.data.title}
                  </h2>
                  {photo.data.snippet &&
                    photo.data.snippet !== photo.data.title && (
                      <p class="mt-2 text-muted leading-relaxed">
                        {photo.data.snippet}
                      </p>
                    )}
                </a>
                <p class="mt-4">
                  <a
                    href="/photos"
                    class="text-sm text-muted hover:text-hover"
                  >
                    Photo gallery
                  </a>
                </p>
              </div>
            )}

            {appearance && (
              <div class="flex flex-col">
                <div class="flex flex-wrap items-center gap-3 text-sm text-muted mb-4">
                  <span class="font-title tracking-wide uppercase text-xs">
                    Latest appearance
                  </span>
                  <span class="text-divider/80" aria-hidden="true">
                    ·
                  </span>
                  <a href={`/blog?type=${appearance.data.type}`}>
                    <Badge type={appearance.data.type ?? 'Podcast'} />
                  </a>
                  <time datetime={appearance.data.pubDate.toISOString()}>
                    {formatDate(appearance.data.pubDate)}
                  </time>
                </div>

                {
                  appearance.data.image && appearance.data.image !== 'null' && (
                    <a
                      href={`/blog/${appearance.id}`}
                      class="block mb-4"
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <img
                        src={appearance.data.image}
                        alt=""
                        class="w-full aspect-video object-cover"
                        loading="lazy"
                      />
                    </a>
                  )
                }

                {appearance.data.name && (
                  <p class="text-sm text-muted mb-1">{appearance.data.name}</p>
                )}
                <h2 class="font-title text-2xl md:text-3xl leading-snug">
                  <a
                    href={`/blog/${appearance.id}`}
                    class="text-foreground hover:text-hover"
                    transition:name={`${appearance.id}-name`}
                  >
                    {appearance.data.title}
                  </a>
                </h2>
                {appearance.data.snippet && (
                  <p class="mt-3 text-muted leading-relaxed line-clamp-4 flex-1">
                    {appearance.data.snippet}
                  </p>
                )}
                <p class="blog-issue-links mt-5">
                  <a
                    href={`/blog/${appearance.id}`}
                    class="blog-issue-links__primary"
                  >
                    On this site
                  </a>
                  {appearance.data.link && (
                    <a
                      href={appearance.data.link}
                      class="blog-issue-links__secondary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Watch / listen
                    </a>
                  )}
                </p>
              </div>
            )}
          </section>
        )}

        {/* Recent writing shelf */}
        {recentWriting.length > 0 && (
          <section class="py-12 md:py-14 border-t border-divider/35" aria-labelledby="more-writing">
            <h2
              id="more-writing"
              class="font-title text-sm tracking-[0.12em] uppercase text-muted mb-7"
            >
              More writing
            </h2>
            <ul class="flex flex-col gap-7">
              {recentWriting.map((post) => (
                <li class="grid gap-1 md:grid-cols-[auto_1fr] md:gap-x-5 md:items-start">
                  <time
                    class="text-sm text-muted md:w-28 shrink-0 md:pt-1"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <div>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <a
                        href={`/blog/${post.id}`}
                        class="font-title text-xl md:text-2xl text-foreground hover:text-hover"
                        transition:name={`${post.id}-name`}
                      >
                        {post.data.title}
                      </a>
                      <a href={`/blog?type=${post.data.type}`}>
                        <Badge type={post.data.type ?? 'Personal'} />
                      </a>
                    </div>
                    {post.data.snippet && (
                      <p class="mt-1.5 text-muted leading-relaxed max-w-2xl line-clamp-2">
                        {post.data.snippet}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Recent appearances shelf */}
        {recentAppearances.length > 0 && (
          <section class="py-12 md:py-14 border-t border-divider/35" aria-labelledby="more-appearances">
            <h2
              id="more-appearances"
              class="font-title text-sm tracking-[0.12em] uppercase text-muted mb-7"
            >
              More appearances
            </h2>
            <ul class="flex flex-col gap-5">
              {recentAppearances.map((post) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <a
                    href={`/blog/${post.id}`}
                    class="font-title text-lg md:text-xl text-foreground hover:text-hover"
                    transition:name={`${post.id}-name`}
                  >
                    {post.data.title}
                  </a>
                  <a href={`/blog?type=${post.data.type}`}>
                    <Badge type={post.data.type ?? 'Podcast'} />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Browse by type */}
        <section
          class="pt-12 md:pt-14 border-t border-divider/35"
          aria-labelledby="browse-types"
        >
          <h2
            id="browse-types"
            class="font-title text-sm tracking-[0.12em] uppercase text-muted mb-7"
          >
            Browse by kind
          </h2>
          <ul class="flex flex-wrap gap-x-5 gap-y-3">
            {browseTypes.map((t) => (
              <li>
                <a
                  href={`/blog?type=${encodeURIComponent(t)}`}
                  class="font-title text-lg md:text-xl text-foreground hover:text-hover inline-flex items-baseline gap-2"
                >
                  <span>{t}</span>
                  <span class="text-sm text-muted font-body font-normal">
                    {typeCounts[t]}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )
  }
</BaseLayout>

<style>
  .blog-issue-masthead {
    animation: blog-issue-in 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .blog-issue-top {
    animation: blog-issue-in 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .blog-issue-poem {
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-background));
  }

  .blog-issue-poem-body {
    text-wrap: pretty;
    font-family: var(--font-body);
  }

  .blog-issue-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.85rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .blog-issue-links__primary {
    color: var(--color-hover);
    text-decoration: none;
  }

  .blog-issue-links__primary:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .blog-issue-links__secondary {
    color: var(--color-muted);
    text-decoration: none;
  }

  .blog-issue-links__secondary:hover {
    color: var(--color-hover);
  }

  @keyframes blog-issue-in {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-issue-masthead,
    .blog-issue-top {
      animation: none;
    }
  }
</style>
