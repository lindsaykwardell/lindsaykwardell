---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PhotoPostLayout from '@/components/PhotoPostLayout.astro'
import ArticlePostLayout from '@/components/ArticlePostLayout.astro'
import { getCollection, getEntry, render } from 'astro:content'
import Fuse from 'fuse.js'
import {
  getDocumentAtUri,
  getPublicationUri,
} from '@/lib/standard-site'
import { readingBackLink } from '@/lib/reading'
import details from '@/content/details/index.json'

const { slug } = Astro.params

const post = await getEntry('blog', slug!)
const posts = await getCollection('blog')

if (!post || (post.data.draft && !import.meta.env.DEV)) {
  return Astro.redirect('/blog')
}

const displayType =
  post.data.type === 'Blog' ? 'Personal' : (post.data.type ?? 'Personal')

const hasImage = (image: string | undefined | null) =>
  Boolean(image && image !== 'null')

const isPhoto = displayType === 'Photo'
const isExternalAppearance = Boolean(post.data.link)
const skipDropCap =
  isExternalAppearance || isPhoto || displayType === 'Poetry'

const publishedOthers = posts.filter(
  (p) => p.id !== post.id && (import.meta.env.DEV || !p.data.draft),
)

const relatedPhotos = (() => {
  if (!isPhoto) return []

  const photoCorpus = publishedOthers
    .filter((p) => p.data.type === 'Photo' && hasImage(p.data.image))
    .map((p) => {
      const tags = (p.data.tags ?? []).filter(
        (t): t is string => typeof t === 'string' && t.length > 0,
      )
      return {
        slug: p.id,
        title: p.data.title,
        snippet: p.data.snippet ?? '',
        image: p.data.image!,
        alt: p.data.snippet || p.data.title,
        tags,
        weekOf: p.data.weekOf ?? '',
        pubDate: p.data.pubDate,
      }
    })

  const photoTags = (post.data.tags ?? []).filter(
    (t): t is string => typeof t === 'string' && t.length > 0,
  )
  const photoQuery = [
    post.data.title,
    post.data.snippet,
    post.data.weekOf,
    ...photoTags,
  ]
    .filter(Boolean)
    .join(' ')

  const photoFuse = new Fuse(photoCorpus, {
    keys: [
      { name: 'title', weight: 0.35 },
      { name: 'snippet', weight: 0.3 },
      { name: 'tags', weight: 0.2 },
      { name: 'weekOf', weight: 0.15 },
    ],
    threshold: 0.45,
    ignoreLocation: true,
  })

  const related = photoFuse
    .search(photoQuery)
    .slice(0, 8)
    .map((r) => ({
      slug: r.item.slug,
      title: r.item.title,
      image: r.item.image,
      alt: r.item.alt,
    }))

  if (related.length > 0) return related

  return photoCorpus
    .toSorted((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
    .slice(0, 8)
    .map((p) => ({
      slug: p.slug,
      title: p.title,
      image: p.image,
      alt: p.alt,
    }))
})()

const relatedCorpus = publishedOthers
  .filter((p) => {
    const type = p.data.type === 'Blog' ? 'Personal' : (p.data.type ?? 'Personal')
    return type !== 'Photo'
  })
  .map((p) => {
    const type = p.data.type === 'Blog' ? 'Personal' : (p.data.type ?? 'Personal')
    const tags = (p.data.tags ?? []).filter(
      (t): t is string => typeof t === 'string' && t.length > 0,
    )
    return {
      ...p.data,
      type,
      slug: p.id,
      tags,
      bodyPreview: (p.body ?? '').slice(0, 1200),
    }
  })

const postTags = (post.data.tags ?? []).filter(
  (t): t is string => typeof t === 'string' && t.length > 0,
)

const fuse = new Fuse(relatedCorpus, {
  keys: [
    { name: 'title', weight: 0.35 },
    { name: 'snippet', weight: 0.2 },
    { name: 'tags', weight: 0.2 },
    { name: 'bodyPreview', weight: 0.15 },
    { name: 'name', weight: 0.05 },
    { name: 'type', weight: 0.05 },
  ],
  threshold: 0.42,
  ignoreLocation: true,
})

const relatedQuery = [
  post.data.title,
  post.data.snippet,
  post.data.name,
  ...postTags,
]
  .filter(Boolean)
  .join(' ')

const relatedWriting = !isPhoto
  ? fuse.search(relatedQuery).slice(0, 3).map((r) => ({
      slug: r.item.slug,
      title: r.item.title,
      snippet: r.item.snippet ?? undefined,
      pubDate: r.item.pubDate,
      type: r.item.type,
    }))
  : []

const relatedFallback =
  !isPhoto && relatedWriting.length === 0
    ? relatedCorpus
        .toSorted((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
        .slice(0, 3)
        .map((item) => ({
          slug: item.slug,
          title: item.title,
          snippet: item.snippet ?? undefined,
          pubDate: item.pubDate,
          type: item.type,
        }))
    : []

const relatedPosts = relatedWriting.length > 0 ? relatedWriting : relatedFallback

const relatedHeading = 'Related'

const { Content } = await render(post)
const documentAtUri = getDocumentAtUri(post.id, post.data.atUri)
const publicationAtUri = getPublicationUri()
const canonicalUrl = `${details.permalink}/blog/${post.id}`

const externalLabel =
  displayType === 'Podcast'
    ? 'Listen'
    : displayType === 'Video'
      ? 'Watch'
      : 'Watch / listen'

const fromFilter = Astro.url.searchParams.get('from')
/** Photos default back to the gallery when no archive context. */
const back = readingBackLink(fromFilter ?? (isPhoto ? 'Photo' : null))

const caption =
  post.data.snippet &&
  post.data.snippet !== post.data.title &&
  !/^Photo:\s*/i.test(post.data.snippet)
    ? post.data.snippet
    : null

const bodyText = (post.body || '').trim()
const showPhotoBody =
  isPhoto &&
  bodyText.length > 0 &&
  bodyText !== post.data.title &&
  bodyText !== post.data.snippet
---

<BaseLayout
  title={post.data.title}
  description={post.data.snippet ?? ''}
  image={post.data.image ?? undefined}
  permalink={`/blog/${post.id}`}
  documentAtUri={documentAtUri}
  publicationAtUri={publicationAtUri}
>
  {
    isPhoto ? (
      <PhotoPostLayout
        post={post}
        back={back}
        caption={caption}
        showBody={showPhotoBody}
        relatedPhotos={relatedPhotos}
        documentAtUri={documentAtUri}
        canonicalUrl={canonicalUrl}
        fromFilter={fromFilter}
      >
        {showPhotoBody && <Content />}
      </PhotoPostLayout>
    ) : (
      <ArticlePostLayout
        post={post}
        back={back}
        externalLabel={externalLabel}
        skipDropCap={skipDropCap}
        isExternalAppearance={isExternalAppearance}
        relatedPosts={relatedPosts}
        relatedHeading={relatedHeading}
        documentAtUri={documentAtUri}
        canonicalUrl={canonicalUrl}
        fromFilter={fromFilter}
      >
        <Content />
      </ArticlePostLayout>
    )
  }
</BaseLayout>
