---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PhotoPostLayout from '@/components/PhotoPostLayout.astro'
import ArticlePostLayout from '@/components/ArticlePostLayout.astro'
import { getCollection, getEntry, render } from 'astro:content'
import Fuse from 'fuse.js'
import {
  getDocumentAtUri,
  getPublicationUri,
} from '@/lib/standard-site'
import { readingBackLink } from '@/lib/reading'
import details from '@/content/details/index.json'

const { slug } = Astro.params

const post = await getEntry('blog', slug!)
const posts = await getCollection('blog')

if (!post || (post.data.draft && !import.meta.env.DEV)) {
  return Astro.redirect('/blog')
}

const displayType =
  post.data.type === 'Blog' ? 'Personal' : (post.data.type ?? 'Personal')

const hasImage = (image: string | undefined | null) =>
  Boolean(image && image !== 'null')

const isPhoto = displayType === 'Photo'
const isExternalAppearance = Boolean(post.data.link)
const skipDropCap =
  isExternalAppearance || isPhoto || displayType === 'Poetry'

const publishedOthers = posts.filter(
  (p) => p.id !== post.id && (import.meta.env.DEV || !p.data.draft),
)

const relatedPhotos = isPhoto
  ? publishedOthers
      .filter((p) => p.data.type === 'Photo' && hasImage(p.data.image))
      .toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
      .slice(0, 8)
      .map((p) => ({
        slug: p.id,
        title: p.data.title,
        image: p.data.image!,
        alt: p.data.snippet || p.data.title,
      }))
  : []

const sameKind = publishedOthers
  .map((p) => {
    const type = p.data.type === 'Blog' ? 'Personal' : p.data.type
    return { ...p.data, type, slug: p.id }
  })
  .filter((p) => p.type === displayType)

const fuse = new Fuse(sameKind, {
  keys: ['title', 'snippet', 'name'],
  threshold: 0.45,
})

const relatedWriting = !isPhoto
  ? fuse.search(post.data.title || '').slice(0, 3).map((r) => r.item)
  : []

const relatedFallback =
  !isPhoto && relatedWriting.length === 0
    ? sameKind
        .toSorted((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
        .slice(0, 3)
    : []

const relatedPosts = relatedWriting.length > 0 ? relatedWriting : relatedFallback

const relatedHeading =
  displayType === 'Poetry'
    ? 'More poetry'
    : ['Podcast', 'Video', 'Meetup', 'Conference'].includes(displayType)
      ? 'More appearances'
      : 'More to read'

const { Content } = await render(post)
const documentAtUri = getDocumentAtUri(post.id, post.data.atUri)
const publicationAtUri = getPublicationUri()
const canonicalUrl = `${details.permalink}/blog/${post.id}`

const externalLabel =
  displayType === 'Podcast'
    ? 'Listen'
    : displayType === 'Video'
      ? 'Watch'
      : 'Watch / listen'

const fromFilter = Astro.url.searchParams.get('from')
/** Photos default back to the gallery when no archive context. */
const back = readingBackLink(fromFilter ?? (isPhoto ? 'Photo' : null))

const caption =
  post.data.snippet &&
  post.data.snippet !== post.data.title &&
  !/^Photo:\s*/i.test(post.data.snippet)
    ? post.data.snippet
    : null

const bodyText = (post.body || '').trim()
const showPhotoBody =
  isPhoto &&
  bodyText.length > 0 &&
  bodyText !== post.data.title &&
  bodyText !== post.data.snippet
---

<BaseLayout
  title={post.data.title}
  description={post.data.snippet ?? ''}
  image={post.data.image ?? undefined}
  permalink={`/blog/${post.id}`}
  documentAtUri={documentAtUri}
  publicationAtUri={publicationAtUri}
>
  {
    isPhoto ? (
      <PhotoPostLayout
        post={post}
        back={back}
        caption={caption}
        showBody={showPhotoBody}
        relatedPhotos={relatedPhotos}
        documentAtUri={documentAtUri}
        canonicalUrl={canonicalUrl}
        fromFilter={fromFilter}
      >
        {showPhotoBody && <Content />}
      </PhotoPostLayout>
    ) : (
      <ArticlePostLayout
        post={post}
        back={back}
        externalLabel={externalLabel}
        skipDropCap={skipDropCap}
        isExternalAppearance={isExternalAppearance}
        relatedPosts={relatedPosts}
        relatedHeading={relatedHeading}
        documentAtUri={documentAtUri}
        canonicalUrl={canonicalUrl}
        fromFilter={fromFilter}
      >
        <Content />
      </ArticlePostLayout>
    )
  }
</BaseLayout>
