---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Signoff from '@/components/Signoff.astro'
import SocialLikes from '@/components/SocialLikes.astro'
import PostComments from '@/components/PostComments.astro'
import Webmentions from '@/components/Webmentions.astro'
import { getCollection, getEntry, render } from 'astro:content'
import Fuse from 'fuse.js'
import {
  getDocumentAtUri,
  getPublicationUri,
} from '@/lib/standard-site'
import details from '@/content/details/index.json'

const { slug } = Astro.params

const post = await getEntry('blog', slug!)
const posts = await getCollection('blog')

if (!post || (post.data.draft && !import.meta.env.DEV)) {
  return Astro.redirect('/blog')
}

const fuse = new Fuse(
  posts
    .filter((p) => p.id !== post.id)
    .map((p) => ({ ...p.data, slug: p.id })),
  {
    keys: ['type', 'title', 'snippet', 'name'],
  },
)
const results = fuse
  .search({
    $and: [
      {
        type: post.data.type || '',
      },
      {
        $or: post.data.title?.split(' ').map((s) => ({ title: s })),
      },
    ],
  })
  .slice(0, 3)

const { Content } = await render(post)
const documentAtUri = getDocumentAtUri(post.id, post.data.atUri)
const publicationAtUri = getPublicationUri()
const canonicalUrl = `${details.permalink}/blog/${post.id}`
const isExternalAppearance = Boolean(post.data.link)
---

<BaseLayout
  title={post.data.title}
  description={post.data.snippet ?? ''}
  image={post.data.image ?? undefined}
  permalink={`/blog/${post.id}`}
  documentAtUri={documentAtUri}
  publicationAtUri={publicationAtUri}
>
  <RootElement>
    <section class="flex flex-col gap-4 items-center pb-12">
      {
        post.data.image && (
          <img src={post.data.image} class="w-full aspect-video object-cover" />
        )
      }
      <h1
        class="text-3xl md:text-4xl px-2 md:px-0"
        transition:name=`${post.id}-name`
      >
        {post.data.title}
      </h1>
      <time class="text-sm text-muted px-2 md:px-0"
        >{Intl.DateTimeFormat('en-us').format(post.data.pubDate)}</time
      >
      {
        post.data.name && (
          <p class="text-sm text-muted px-2 md:px-0">{post.data.name}</p>
        )
      }
      {
        post.data.link && (
          <a
            href={post.data.link}
            class="break-all text-sm underline text-muted hover:text-hover px-2 md:px-0"
            target="_blank"
            rel="noopener noreferrer"
          >
            {post.data.link}
          </a>
        )
      }
      {
        post.data.draft && (
          <div class="italic text-3xl text-hover ">
            ------------- DRAFT -------------
          </div>
        )
      }
    </section>
    <div
      class:list={[
        'prose max-w-full bg-background prose-lg md:prose-xl m-auto p-4 md:p-12 rounded shadow-md',
        isExternalAppearance && 'appearance-post',
      ]}
    >
      <article>
        <Content />
      </article>
      {
        !isExternalAppearance && (
          <footer class="post-afterword not-prose">
            <SocialLikes
              blueskyUri={post.data.blueskyUri}
              blueskyUrl={post.data.blueskyUrl}
              mastodonId={post.data.mastodonId}
              mastodonUrl={post.data.mastodonUrl}
              devtoId={post.data.devtoId}
              devtoUrl={post.data.devtoUrl}
              documentAtUri={documentAtUri}
              showRecommend={Boolean(documentAtUri)}
            />
            {(post.data.blueskyUri ||
              post.data.mastodonId ||
              post.data.devtoId) && (
              <PostComments
                blueskyUri={post.data.blueskyUri}
                mastodonId={post.data.mastodonId}
                devtoId={post.data.devtoId}
                devtoUrl={post.data.devtoUrl}
              />
            )}
            <Webmentions targetUrl={canonicalUrl} />
          </footer>
        )
      }
      <Signoff />
    </div>
    {
      documentAtUri && !isExternalAppearance && (
        <script>
          import '@/components/sequoia-subscribe.js'
        </script>
      )
    }
    {
      results.length > 0 && (
        <aside class="py-8">
          <h1 class="text-xl md:text-3xl px-2 md:px-0">Similar Posts</h1>
          <div class="md:flex">
            {results.map((result) => (
              <a href={`/blog/${result.item.slug}`} class="md:w-1/3">
                <div class="m-2 bg-background rounded shadow-md">
                  <div>
                    <img
                      src={result.item.image}
                      class="aspect-video w-full object-cover md:h-50"
                    />
                  </div>
                  <h2 class="p-2">{result.item.title}</h2>
                  <time class="text-sm text-muted p-2">
                    {Intl.DateTimeFormat('en-us').format(result.item.pubDate)}
                  </time>
                  <p class="p-2 text-sm">{result.item.snippet}</p>
                </div>
              </a>
            ))}
          </div>
        </aside>
      )
    }
  </RootElement>
</BaseLayout>

<style>
  article {
    p:first-of-type:first-line {
      color: var(--color-hover);
      font-weight: bold;
      font-size: var(--text-2xl);
      font-family: var(--font-title);
    }
  }

  /* Appearances are short blurbs — skip the drop-cap treatment */
  .appearance-post article p:first-of-type:first-line {
    color: inherit;
    font-weight: inherit;
    font-size: inherit;
    font-family: inherit;
  }
</style>
