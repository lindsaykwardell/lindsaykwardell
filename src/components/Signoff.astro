---
import SocialLinks from './SocialLinks.astro'
import EmailSubscribe from './EmailSubscribe.astro'

interface Props {
  variant?: 'footer' | 'post'
}

const variant = Astro.props.variant ?? 'post'
---

{
  variant === 'post' ? (
    <section class="post-signoff not-prose" aria-label="About the author">
      <a href="/about" class="post-signoff__portrait">
        <img
          src="/lindsay2.jpg"
          alt=""
          width="72"
          height="72"
          loading="lazy"
          decoding="async"
          class="post-signoff__img"
        />
      </a>
      <div class="post-signoff__copy">
        <a href="/about" class="post-signoff__name font-title">
          Lindsay Wardell
        </a>
        <p class="post-signoff__line">Programmer and writer.</p>
        <div class="post-signoff__links">
          <SocialLinks class="post-signoff__social" />
        </div>
      </div>
      <div class="post-signoff__email">
        <EmailSubscribe />
      </div>
    </section>
  ) : (
    <div class="signoff-icons">
      <SocialLinks class="justify-center gap-4 pb-8" />
      <div class="max-w-125 m-auto pb-12">
        <EmailSubscribe />
      </div>
    </div>
  )
}

<style>
  .post-signoff {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-divider) 40%, transparent);
    max-width: 40rem;
  }

  .post-signoff__portrait {
    flex-shrink: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    line-height: 0;
    transition: opacity 0.15s ease;
  }

  .post-signoff__portrait:hover {
    opacity: 0.88;
  }

  .post-signoff__img {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .post-signoff__copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    flex: 0 1 auto;
  }

  .post-signoff__email {
    flex: 0 1 17rem;
    width: 17rem;
    max-width: 100%;
    height: fit-content;
    align-self: center;
  }

  .post-signoff__name {
    font-size: 1.125rem;
    color: var(--color-foreground);
    text-decoration: none;
    line-height: 1.25;
    transition: color 0.15s ease;
  }

  .post-signoff__name:hover {
    color: var(--color-hover);
  }

  .post-signoff__line {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .post-signoff__links {
    margin-top: 0.45rem;
  }

  .post-signoff__links :global(a) {
    color: var(--color-muted);
  }

  .post-signoff__links :global(a:hover) {
    color: var(--color-hover);
  }

  /* SVG width/height attrs fight CSS sizing — scale the row instead */
  .post-signoff__links :global(.post-signoff__social) {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.65rem;
    width: auto;
    transform: scale(0.72);
    transform-origin: left center;
  }

  .post-signoff__portrait:focus-visible,
  .post-signoff__name:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Side-by-side gets tight: keep email compact under the bio, not stretched */
  @media (max-width: 720px) {
    .post-signoff {
      align-items: flex-start;
    }

    .post-signoff__email {
      flex: 1 1 100%;
      width: auto;
      margin-left: calc(4.5rem + 0.85rem);
      align-self: stretch;
    }
  }

  @media (max-width: 480px) {
    .post-signoff__img {
      width: 3.75rem;
      height: 3.75rem;
    }

    .post-signoff__email {
      margin-left: calc(3.75rem + 0.85rem);
    }
  }
</style>
