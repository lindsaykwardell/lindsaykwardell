---
import type { CollectionEntry } from 'astro:content'
import { formatReadingDate } from '@/lib/reading'

type Post = CollectionEntry<'blog'>

interface Props {
  lead?: Post
  recentWriting: Post[]
  browseTypes: string[]
  typeCounts: Record<string, number>
}

const { lead, recentWriting, browseTypes, typeCounts } = Astro.props
---

<div class="reading px-2 md:px-0 pb-16">
  <header class="reading-masthead pb-6 md:pb-8">
    <h1 class="font-title text-3xl md:text-4xl text-foreground">Reading</h1>
  </header>

  {
    lead && (
      <section
        class="reading-lead pb-10 md:pb-12"
        aria-labelledby="lead-title"
      >
        <div class="flex flex-wrap items-center gap-3 text-sm text-muted mb-4">
          <span class="font-title tracking-wide uppercase text-xs">
            Latest writing
          </span>
          <span class="text-divider/80" aria-hidden="true">
            ·
          </span>
          <time datetime={lead.data.pubDate.toISOString()}>
            {formatReadingDate(lead.data.pubDate)}
          </time>
        </div>

        {lead.data.image && lead.data.image !== 'null' && (
          <a
            href={`/blog/${lead.id}`}
            class="block mb-5 -mx-2 md:mx-0 overflow-hidden"
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={lead.data.image}
              alt=""
              class="w-full aspect-[16/9] object-cover"
              loading="eager"
            />
          </a>
        )}

        <h2
          id="lead-title"
          class="font-title text-3xl md:text-4xl leading-tight max-w-3xl"
        >
          <a
            href={`/blog/${lead.id}`}
            class="text-foreground hover:text-hover"
            transition:name={`${lead.id}-name`}
          >
            {lead.data.title}
          </a>
        </h2>
        {lead.data.snippet && (
          <p class="mt-3 text-lg text-muted leading-relaxed max-w-2xl">
            {lead.data.snippet}
          </p>
        )}
      </section>
    )
  }

  {
    recentWriting.length > 0 && (
      <section
        class="reading-recent pt-10 md:pt-12 pb-10 md:pb-12 border-t border-divider/35"
        aria-labelledby="recent-writing"
      >
        <h2
          id="recent-writing"
          class="font-title text-sm tracking-[0.12em] uppercase text-muted mb-7"
        >
          Recent
        </h2>
        <ul class="flex flex-col gap-7">
          {recentWriting.map((post) => (
            <li class="grid gap-1 md:grid-cols-[auto_1fr] md:gap-x-5 md:items-start">
              <time
                class="text-sm text-muted md:w-28 shrink-0 md:pt-1"
                datetime={post.data.pubDate.toISOString()}
              >
                {formatReadingDate(post.data.pubDate)}
              </time>
              <div>
                <a
                  href={`/blog/${post.id}`}
                  class="font-title text-xl md:text-2xl text-foreground hover:text-hover"
                  transition:name={`${post.id}-name`}
                >
                  {post.data.title}
                </a>
                {post.data.snippet && (
                  <p class="mt-1.5 text-muted leading-relaxed max-w-2xl line-clamp-2">
                    {post.data.snippet}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section
    class="pt-10 md:pt-12 border-t border-divider/35"
    aria-labelledby="browse-types"
  >
    <h2
      id="browse-types"
      class="font-title text-sm tracking-[0.12em] uppercase text-muted mb-7"
    >
      Browse by kind
    </h2>
    <ul class="flex flex-wrap gap-x-5 gap-y-3">
      {
        browseTypes.map((t) => (
          <li>
            <a
              href={`/blog?type=${encodeURIComponent(t)}`}
              class="font-title text-lg md:text-xl text-foreground hover:text-hover inline-flex items-baseline gap-2"
            >
              <span>{t}</span>
              <span class="text-sm text-muted font-body font-normal">
                {typeCounts[t]}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .reading-masthead,
  .reading-lead {
    animation: reading-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes reading-in {
    from {
      opacity: 0;
      transform: translateY(0.55rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-masthead,
    .reading-lead {
      animation: none;
    }
  }
</style>
