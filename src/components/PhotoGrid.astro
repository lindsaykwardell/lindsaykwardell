---
export type PhotoCard = {
  id: string
  href: string
  url: string
  alt: string
}

interface Props {
  photos: PhotoCard[]
}

const { photos } = Astro.props
---

{
  photos.length === 0 ? (
    <p class="text-muted text-lg pt-4">
      No photos yet.{' '}
      <a href="/blog" class="text-hover hover:underline underline-offset-4">
        Back to Blog
      </a>
    </p>
  ) : (
    <div class="photo-grid columns-2 md:columns-3 gap-2 -mx-1 md:mx-0">
      {photos.map((photo) => (
        <a href={photo.href} class="mb-2 block break-inside-avoid">
          <img
            src={photo.url}
            alt={photo.alt}
            class="rounded w-full transition-opacity duration-300"
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  )
}

<style>
  .photo-grid:hover img {
    opacity: 0.6;
  }
  .photo-grid a:hover img {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-grid img {
      transition: none;
    }
  }
</style>
