---
export type PhotoCard = {
  id: string
  href: string
  url: string
  alt: string
}

interface Props {
  photos: PhotoCard[]
}

const { photos } = Astro.props
---

{
  photos.length === 0 ? (
    <p class="text-muted text-lg pt-4">
      No photos yet.{' '}
      <a href="/blog" class="text-hover hover:underline underline-offset-4">
        Back to Blog
      </a>
    </p>
  ) : (
    <div class="photo-grid">
      {photos.map((photo) => (
        <a href={photo.href} class="photo-grid__item">
          <img
            src={photo.url}
            alt={photo.alt}
            class="photo-grid__img"
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </div>
  )
}

<style>
  .photo-grid {
    columns: 2;
    column-gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .photo-grid {
      columns: 3;
      column-gap: 1.15rem;
    }
  }

  .photo-grid__item {
    display: block;
    break-inside: avoid;
    margin-bottom: 0.85rem;
  }

  @media (min-width: 768px) {
    .photo-grid__item {
      margin-bottom: 1.15rem;
    }
  }

  .photo-grid__img {
    display: block;
    width: 100%;
    border-radius: 0.2rem;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-grid:hover .photo-grid__img {
    opacity: 0.55;
  }

  .photo-grid__item:hover .photo-grid__img {
    opacity: 1;
    transform: scale(1.01);
  }

  .photo-grid__item:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-grid__img {
      transition: none;
    }

    .photo-grid__item:hover .photo-grid__img {
      transform: none;
    }
  }
</style>
