---
import PostEngagement from '@/components/PostEngagement.astro'
import { formatReadingDate, readingPostHref } from '@/lib/reading'
import type { CollectionEntry } from 'astro:content'

export type RelatedPhoto = {
  slug: string
  title: string
  image: string
  alt: string
}

interface Props {
  post: CollectionEntry<'blog'>
  back: { href: string; label: string }
  caption: string | null
  showBody: boolean
  relatedPhotos: RelatedPhoto[]
  documentAtUri: string | null
  canonicalUrl: string
  fromFilter: string | null
}

const {
  post,
  back,
  caption,
  showBody,
  relatedPhotos,
  documentAtUri,
  canonicalUrl,
  fromFilter,
} = Astro.props

const hasImage = Boolean(post.data.image && post.data.image !== 'null')
---

<article class="photo-page pb-16 md:pb-20">
  <header class="photo-page-header">
    <div class="photo-page-meta text-sm text-muted">
      <a href={back.href} class="photo-page-back">
        <span class="photo-page-back__arrow" aria-hidden="true">←</span>
        {back.label}
      </a>
      <span class="text-divider/80" aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {formatReadingDate(post.data.pubDate)}
      </time>
    </div>
  </header>

  {
    hasImage && (
      <figure class="photo-page-figure">
        <img
          src={post.data.image!}
          alt={caption || post.data.title}
          class="photo-page-figure__img"
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  <div class="photo-page-caption">
    <h1
      class="photo-page-title font-title text-pretty"
      transition:name={`${post.id}-name`}
    >
      {post.data.title}
    </h1>
    {
      caption && (
        <p class="photo-page-lede text-muted text-pretty">{caption}</p>
      )
    }
    {
      showBody && (
        <div class="photo-page-body prose prose-lg max-w-none text-muted">
          <slot />
        </div>
      )
    }
    {
      post.data.draft && (
        <p class="photo-page-draft text-sm italic text-hover tracking-wide">
          Draft
        </p>
      )
    }
  </div>

  <footer class="photo-page-afterword post-afterword not-prose">
    <PostEngagement
      blueskyUri={post.data.blueskyUri}
      blueskyUrl={post.data.blueskyUrl}
      mastodonId={post.data.mastodonId}
      mastodonUrl={post.data.mastodonUrl}
      devtoId={post.data.devtoId}
      devtoUrl={post.data.devtoUrl}
      documentAtUri={documentAtUri}
      canonicalUrl={canonicalUrl}
      showRecommend={Boolean(documentAtUri)}
    />
  </footer>

  {
    documentAtUri && (
      <script>
        import '@/components/sequoia-subscribe.js'
      </script>
    )
  }

  {
    relatedPhotos.length > 0 && (
      <aside class="photo-page-more" aria-labelledby="photo-more-heading">
        <div class="photo-page-more__head">
          <h2
            id="photo-more-heading"
            class="font-title text-sm tracking-[0.12em] uppercase text-muted"
          >
            Related
          </h2>
          <a href="/blog?type=Photo" class="photo-page-more__all">
            All photos
          </a>
        </div>
        <div class="photo-page-strip">
          {relatedPhotos.map((item) => (
            <a
              href={readingPostHref(item.slug, fromFilter ?? 'Photo')}
              class="photo-page-strip__link"
              transition:name={`${item.slug}-name`}
            >
              <img
                src={item.image}
                alt={item.alt}
                class="photo-page-strip__img"
                loading="lazy"
                decoding="async"
              />
              <span class="sr-only">{item.title}</span>
            </a>
          ))}
        </div>
      </aside>
    )
  }
</article>

<style>
  .photo-page-header {
    max-width: 42rem;
    margin-inline: auto;
    padding: 0 1.25rem 1.5rem;
  }

  @media (min-width: 768px) {
    .photo-page-header {
      padding: 0 0 1.75rem;
      max-width: none;
    }
  }

  .photo-page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.75rem;
    animation: photo-settle 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .photo-page-back {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-page-back__arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-page-back:hover {
    color: var(--color-hover);
  }

  .photo-page-back:hover .photo-page-back__arrow {
    transform: translateX(-0.2rem);
  }

  .photo-page-back:focus-visible,
  .photo-page-strip__link:focus-visible,
  .photo-page-more__all:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .photo-page-figure {
    display: flex;
    justify-content: center;
    padding-inline: 0.5rem;
    animation: photo-settle 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.04s both;
  }

  @media (min-width: 768px) {
    .photo-page-figure {
      padding-inline: 0;
    }
  }

  .photo-page-figure__img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(78vh, 48rem);
    object-fit: contain;
    border-radius: 0.2rem;
    box-shadow: var(--shadow-paper);
    transform: scale(1.015);
    transform-origin: center;
    animation: photo-reveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.06s both;
  }

  .photo-page-caption {
    max-width: 36rem;
    margin: 1.75rem auto 0;
    padding-inline: 1.25rem;
    animation: photo-settle 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  @media (min-width: 768px) {
    .photo-page-caption {
      margin-top: 2.25rem;
      padding-inline: 0;
    }
  }

  .photo-page-title {
    margin: 0;
    color: var(--color-foreground);
    font-size: clamp(1.65rem, 1.35rem + 1.1vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .photo-page-lede {
    margin: 0.65rem 0 0;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .photo-page-body {
    margin-top: 1.15rem;
  }

  .photo-page-body :global(p) {
    line-height: 1.7;
  }

  .photo-page-draft {
    margin: 0.85rem 0 0;
  }

  .photo-page-afterword {
    max-width: 36rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
    margin-top: 2.5rem;
    animation: photo-settle 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.14s both;
  }

  @media (min-width: 768px) {
    .photo-page-afterword {
      padding-inline: 0;
    }
  }

  .photo-page-more {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-divider) 40%, transparent);
  }

  @media (min-width: 768px) {
    .photo-page-more {
      margin-top: 4.5rem;
      padding-top: 3rem;
    }
  }

  .photo-page-more__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .photo-page-more__all {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .photo-page-more__all:hover {
    color: var(--color-hover);
  }

  .photo-page-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  @media (min-width: 480px) {
    .photo-page-strip {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .photo-page-strip {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
  }

  .photo-page-strip__link {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 0.2rem;
    background: color-mix(
      in srgb,
      var(--color-accent) 8%,
      var(--color-background)
    );
  }

  .photo-page-strip__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .photo-page-strip:hover .photo-page-strip__img {
    opacity: 0.55;
  }

  .photo-page-strip__link:hover .photo-page-strip__img {
    opacity: 1;
    transform: scale(1.04);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes photo-settle {
    from {
      opacity: 0;
      transform: translateY(0.55rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes photo-reveal {
    from {
      transform: scale(1.02);
      opacity: 0.85;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-page-meta,
    .photo-page-figure,
    .photo-page-figure__img,
    .photo-page-caption,
    .photo-page-afterword {
      animation: none;
    }

    .photo-page-figure__img {
      transform: none;
      opacity: 1;
    }

    .photo-page-back,
    .photo-page-back__arrow,
    .photo-page-strip__img,
    .photo-page-more__all {
      transition: none;
    }

    .photo-page-back:hover .photo-page-back__arrow {
      transform: none;
    }

    .photo-page-strip:hover .photo-page-strip__img,
    .photo-page-strip__link:hover .photo-page-strip__img {
      opacity: 1;
      transform: none;
    }
  }
</style>
