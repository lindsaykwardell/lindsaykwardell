---
/**
 * Image-first layout for Photo posts — gallery feel, quiet afterword.
 */
import Signoff from '@/components/Signoff.astro'
import PostEngagement from '@/components/PostEngagement.astro'
import { readingPostHref } from '@/lib/reading'
import type { CollectionEntry } from 'astro:content'

export type RelatedPhoto = {
  slug: string
  title: string
  image: string
  alt: string
}

interface Props {
  post: CollectionEntry<'blog'>
  back: { href: string; label: string }
  caption: string | null
  showBody: boolean
  relatedPhotos: RelatedPhoto[]
  documentAtUri: string | null
  canonicalUrl: string
  fromFilter: string | null
}

const {
  post,
  back,
  caption,
  showBody,
  relatedPhotos,
  documentAtUri,
  canonicalUrl,
  fromFilter,
} = Astro.props

const formatDate = (date: Date) =>
  Intl.DateTimeFormat('en-us', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date)

const hasImage = Boolean(post.data.image && post.data.image !== 'null')
---

<article class="photo-page pb-16">
  <header
    class="photo-page-meta flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-muted px-2 md:px-0 pb-6 md:pb-8"
  >
    <a href={back.href} class="post-page-back">
      <span class="post-page-back__arrow" aria-hidden="true">←</span>
      {back.label}
    </a>
    <span class="text-divider/80" aria-hidden="true">·</span>
    <time datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
  </header>

  {
    hasImage && (
      <figure class="photo-page-figure px-2 md:px-0">
        <img
          src={post.data.image!}
          alt={caption || post.data.title}
          class="photo-page-figure__img"
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  <div
    class="photo-page-caption text-center px-4 md:px-0 max-w-xl mx-auto pt-6 md:pt-8"
  >
    <h1
      class="font-title text-2xl md:text-3xl text-foreground text-pretty leading-snug"
      transition:name={`${post.id}-name`}
    >
      {post.data.title}
    </h1>
    {
      caption && (
        <p class="mt-2 text-muted text-base md:text-lg leading-relaxed text-pretty">
          {caption}
        </p>
      )
    }
    {
      showBody && (
        <div class="photo-page-body prose prose-lg max-w-none mt-4 text-muted">
          <slot />
        </div>
      )
    }
    {
      post.data.draft && (
        <p class="mt-3 text-sm italic text-hover tracking-wide">Draft</p>
      )
    }
  </div>

  <footer
    class="photo-page-afterword not-prose max-w-2xl mx-auto px-4 md:px-0 pt-8 md:pt-10"
  >
    <PostEngagement
      blueskyUri={post.data.blueskyUri}
      blueskyUrl={post.data.blueskyUrl}
      mastodonId={post.data.mastodonId}
      mastodonUrl={post.data.mastodonUrl}
      devtoId={post.data.devtoId}
      devtoUrl={post.data.devtoUrl}
      documentAtUri={documentAtUri}
      canonicalUrl={canonicalUrl}
      showRecommend={Boolean(documentAtUri)}
    />
  </footer>

  {
    documentAtUri && (
      <script>
        import '@/components/sequoia-subscribe.js'
      </script>
    )
  }

  {
    relatedPhotos.length > 0 && (
      <aside
        class="photo-page-more px-2 md:px-0 pt-12 md:pt-14 mt-4"
        aria-label="More from the gallery"
      >
        <div class="photo-page-strip">
          {relatedPhotos.map((item) => (
            <a
              href={readingPostHref(item.slug, fromFilter ?? 'Photo')}
              class="photo-page-strip__link"
              transition:name={`${item.slug}-name`}
            >
              <img
                src={item.image}
                alt={item.alt}
                class="photo-page-strip__img"
                loading="lazy"
                decoding="async"
              />
              <span class="sr-only">{item.title}</span>
            </a>
          ))}
        </div>
        <p class="text-center mt-6">
          <a
            href="/blog?type=Photo"
            class="text-sm text-muted hover:text-hover transition-colors"
          >
            All photos
          </a>
        </p>
      </aside>
    )
  }

  <div class="max-w-2xl mx-auto px-4 pt-10 md:pt-12">
    <Signoff hideIntro />
  </div>
</article>

<style>
  .post-page-back {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-page-back__arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-page-back:hover {
    color: var(--color-hover);
  }

  .post-page-back:hover .post-page-back__arrow {
    transform: translateX(-0.2rem);
  }

  .post-page-back:focus-visible,
  .photo-page-strip__link:focus-visible,
  .photo-page-meta a:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .photo-page-meta {
    animation: post-settle 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .photo-page-figure {
    display: flex;
    justify-content: center;
    animation: post-settle 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.04s both;
  }

  .photo-page-figure__img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(82vh, 56rem);
    object-fit: contain;
    transform: scale(1.02);
    transform-origin: center;
    animation: post-hero-ease 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.06s both;
  }

  .photo-page-caption {
    animation: post-settle 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .photo-page-afterword {
    animation: post-settle 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.14s both;
  }

  .photo-page-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
  }

  @media (min-width: 768px) {
    .photo-page-strip {
      grid-template-columns: repeat(8, 1fr);
      gap: 0.5rem;
    }
  }

  .photo-page-strip__link {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    background: color-mix(
      in srgb,
      var(--color-accent) 8%,
      var(--color-background)
    );
  }

  .photo-page-strip__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease;
  }

  .photo-page-strip:hover .photo-page-strip__img {
    opacity: 0.55;
  }

  .photo-page-strip__link:hover .photo-page-strip__img {
    opacity: 1;
    transform: scale(1.04);
  }

  @keyframes post-settle {
    from {
      opacity: 0;
      transform: translateY(0.55rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes post-hero-ease {
    from {
      transform: scale(1.03);
      opacity: 0.85;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-page-meta,
    .photo-page-figure,
    .photo-page-figure__img,
    .photo-page-caption,
    .photo-page-afterword {
      animation: none;
    }

    .photo-page-figure__img {
      transform: none;
      opacity: 1;
    }

    .post-page-back,
    .post-page-back__arrow,
    .photo-page-strip__img {
      transition: none;
    }

    .post-page-back:hover .post-page-back__arrow {
      transform: none;
    }

    .photo-page-strip:hover .photo-page-strip__img,
    .photo-page-strip__link:hover .photo-page-strip__img {
      opacity: 1;
      transform: none;
    }
  }
</style>
