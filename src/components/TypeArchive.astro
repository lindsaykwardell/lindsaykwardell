---
import type { CollectionEntry } from 'astro:content'
import ArchiveShell from '@/components/ArchiveShell.astro'
import PostList from '@/components/PostList.astro'
import { readingPostHref } from '@/lib/reading'

type Post = CollectionEntry<'blog'>

interface Props {
  type: string
  postsByYear: Record<string, Post[]>
  count: number
  searchPosts: Post[]
}

const { type, postsByYear, count, searchPosts } = Astro.props

const years = Object.entries(postsByYear).toSorted((a, b) => +b[0] - +a[0])
---

<ArchiveShell
  title={type}
  count={count}
  countLabel={count === 1 ? 'piece' : 'pieces'}
  searchPosts={searchPosts}
  fromType={type}
  placeholder={`Search ${type.toLowerCase()}…`}
>
  <ul class="flex flex-col gap-10 md:gap-12">
    {
      years.map(([year, posts]) => (
        <li>
          <h2 class="font-title text-xl text-muted mb-7">{year}</h2>
          <PostList
            showType={false}
            posts={posts.map((post) => ({
              id: post.id,
              href: readingPostHref(post.id, type),
              title: post.data.title,
              snippet: post.data.snippet,
              pubDate: post.data.pubDate,
              type: post.data.type,
              draft: post.data.draft,
            }))}
          />
        </li>
      ))
    }
  </ul>
</ArchiveShell>
