---
interface Props {
  type: string
}

const { type } = Astro.props

/** One soft wash per kind — distinct enough to scan, quiet enough for the essay site. */
const colorMap: Record<string, string> = {
  Blog: 'bg-badge-blog', // legacy alias
  Personal: 'bg-badge-blog',
  Programming: 'bg-badge-programming',
  Poetry: 'bg-badge-poetry',
  Fiction: 'bg-badge-fiction',
  Photo: 'bg-badge-photo',
  Podcast: 'bg-badge-podcast',
  Video: 'bg-badge-video',
  Meetup: 'bg-badge-meetup',
  Conference: 'bg-badge-conference',
  // legacy lowercase
  podcast: 'bg-badge-podcast',
  video: 'bg-badge-video',
  conference: 'bg-badge-conference',
}

const bgColor = colorMap[type] ?? 'bg-badge-default'
---

<span class={`rounded-lg text-muted text-sm px-2 py-1 ${bgColor}`}>
  <slot>{type.toLowerCase()}</slot>
</span>
