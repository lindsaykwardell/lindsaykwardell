---
const url = new URL(Astro.request.url)
const pathname = url.pathname
const type = url.searchParams.get('type')
const currentPath = pathname.slice(1) // remove the first "/"

const isPhotos =
  currentPath.startsWith('photos') ||
  (currentPath.startsWith('blog') && type === 'Photo')
const isReading =
  currentPath.startsWith('blog') && type !== 'Photo'
---

<nav class="flex gap-2 text-sm md:text-base" transition:name="nav">
  <a class="font-title hidden md:block" href="/">Home</a>
  <div class="text-divider hidden md:block">/</div>
  <a
    class={currentPath.includes('about')
      ? 'underline font-title'
      : 'font-title'}
    href="/about">About</a
  >
  <div class="text-divider">/</div>
  <a
    class={isReading ? 'underline font-title' : 'font-title'}
    href="/blog">Reading</a
  >
  <div class="text-divider">/</div>
  <a
    class={isPhotos ? 'underline font-title' : 'font-title'}
    href="/blog?type=Photo">Photos</a
  >
  <div class="text-divider">/</div>
  <a
    class={currentPath.includes('@lindsay')
      ? 'underline font-title'
      : 'font-title'}
    href="/@lindsay">Social</a
  >
</nav>
