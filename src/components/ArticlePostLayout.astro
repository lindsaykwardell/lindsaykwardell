---
import PostEngagement from '@/components/PostEngagement.astro'
import PostList from '@/components/PostList.astro'
import type { PostListItem } from '@/components/PostList.astro'
import { formatReadingDate, readingPostHref } from '@/lib/reading'
import type { CollectionEntry } from 'astro:content'

export type RelatedPost = {
  slug: string
  title: string
  snippet?: string
  pubDate: Date
  type?: string
}

interface Props {
  post: CollectionEntry<'blog'>
  back: { href: string; label: string }
  externalLabel: string
  skipDropCap: boolean
  isExternalAppearance: boolean
  relatedPosts: RelatedPost[]
  relatedHeading: string
  documentAtUri: string | null
  canonicalUrl: string
  fromFilter: string | null
}

const {
  post,
  back,
  externalLabel,
  skipDropCap,
  isExternalAppearance,
  relatedPosts,
  relatedHeading,
  documentAtUri,
  canonicalUrl,
  fromFilter,
} = Astro.props

const hasImage = Boolean(post.data.image && post.data.image !== 'null')

const relatedItems: PostListItem[] = relatedPosts.map((item) => ({
  id: item.slug,
  href: readingPostHref(item.slug, fromFilter),
  title: item.title,
  snippet: item.snippet,
  pubDate: item.pubDate,
  type: item.type,
}))
---

<article class="post-page pb-16 md:pb-20">
  <header class="post-page-header">
    <div class="post-page-meta text-sm text-muted">
      <a href={back.href} class="post-page-back">
        <span class="post-page-back__arrow" aria-hidden="true">←</span>
        {back.label}
      </a>
      <span class="text-divider/80" aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {formatReadingDate(post.data.pubDate)}
      </time>
    </div>

    <h1
      class="post-page-title font-title text-pretty"
      transition:name={`${post.id}-name`}
    >
      {post.data.title}
    </h1>

    {post.data.name && <p class="post-page-show text-muted">{post.data.name}</p>}

    {
      post.data.link && (
        <p class="post-external">
          <a
            href={post.data.link}
            class="post-external__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {externalLabel}
          </a>
        </p>
      )
    }

    {
      post.data.draft && (
        <p class="post-page-draft text-sm italic text-hover tracking-wide">
          Draft
        </p>
      )
    }

    {
      hasImage && (
        <div class="post-page-hero">
          <img
            src={post.data.image!}
            alt=""
            class="post-page-hero__img"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
  </header>

  <div
    class:list={[
      'post-page-surface prose prose-lg max-w-none bg-background m-auto rounded',
      skipDropCap && 'post-page--plain',
    ]}
  >
    <div class="post-page-body">
      <slot />
    </div>
    {
      !isExternalAppearance && (
        <footer class="post-afterword not-prose">
          <PostEngagement
            blueskyUri={post.data.blueskyUri}
            blueskyUrl={post.data.blueskyUrl}
            mastodonId={post.data.mastodonId}
            mastodonUrl={post.data.mastodonUrl}
            devtoId={post.data.devtoId}
            devtoUrl={post.data.devtoUrl}
            documentAtUri={documentAtUri}
            canonicalUrl={canonicalUrl}
            showRecommend={Boolean(documentAtUri)}
          />
        </footer>
      )
    }
  </div>

  {
    documentAtUri && !isExternalAppearance && (
      <script>
        import '@/components/sequoia-subscribe.js'
      </script>
    )
  }

  {
    relatedItems.length > 0 && (
      <aside
        class="post-related px-2 md:px-0 pt-14 md:pt-16"
        aria-labelledby="related-heading"
      >
        <h2
          id="related-heading"
          class="font-title text-sm tracking-[0.12em] uppercase text-muted mb-7"
        >
          {relatedHeading}
        </h2>
        <PostList posts={relatedItems} />
      </aside>
    )
  }
</article>

<style>
  .post-page-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    padding: 0 1.25rem 2rem;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .post-page-header {
      padding: 0 3rem 2.5rem;
    }
  }

  .post-page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.75rem;
    animation: post-settle 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .post-page-back {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-page-back__arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-page-back:hover {
    color: var(--color-hover);
  }

  .post-page-back:hover .post-page-back__arrow {
    transform: translateX(-0.2rem);
  }

  .post-page-back:focus-visible,
  .post-page-header a:focus-visible {
    outline: 2px solid var(--color-hover);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .post-page-title {
    margin: 0.15rem 0 0;
    color: var(--color-foreground);
    font-size: clamp(1.85rem, 1.4rem + 1.6vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    animation: post-settle 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.06s both;
  }

  .post-page-show {
    margin: 0;
    font-size: 0.9375rem;
  }

  .post-page-draft {
    margin: 0;
  }

  .post-page-hero {
    width: 100%;
    margin-top: 0.75rem;
    overflow: hidden;
    border-radius: 0.2rem;
    animation: post-settle 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }

  .post-page-hero__img {
    display: block;
    width: 100%;
    max-height: min(52vh, 28rem);
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    transform-origin: center;
    animation: post-hero-ease 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .post-page-surface {
    max-width: 42rem;
    padding: 1.35rem 1.25rem 1.75rem;
    box-shadow: var(--shadow-paper);
    animation: post-settle 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  @media (min-width: 768px) {
    .post-page-surface {
      padding: 2.75rem 3rem 3rem;
    }
  }

  /* Comfortable essay measure + leading — share edge with title */
  .post-page-body {
    max-width: none;
  }

  .post-page-body :global(p),
  .post-page-body :global(li) {
    line-height: 1.75;
  }

  .post-page-body :global(p + p) {
    margin-top: 1.15em;
  }

  /* Quiet opening — weight only, no accent hijack */
  .post-page-body :global(> p:first-of-type) {
    font-size: 1.08em;
    line-height: 1.7;
  }

  .post-page--plain .post-page-body :global(> p:first-of-type) {
    font-size: inherit;
    line-height: 1.75;
  }

  .post-external {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.85rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .post-external__link {
    color: var(--color-hover);
    text-decoration: none;
    transition: text-underline-offset 0.2s ease;
  }

  .post-external__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @keyframes post-settle {
    from {
      opacity: 0;
      transform: translateY(0.55rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes post-hero-ease {
    from {
      transform: scale(1.02);
      opacity: 0.85;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-page-meta,
    .post-page-hero,
    .post-page-hero__img,
    .post-page-title,
    .post-page-surface {
      animation: none;
    }

    .post-page-hero__img {
      transform: none;
      opacity: 1;
    }

    .post-page-back,
    .post-page-back__arrow {
      transition: none;
    }

    .post-page-back:hover .post-page-back__arrow {
      transform: none;
    }
  }
</style>
