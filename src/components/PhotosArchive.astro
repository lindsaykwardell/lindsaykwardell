---
import ArchiveShell from '@/components/ArchiveShell.astro'
import PhotoGrid from '@/components/PhotoGrid.astro'
import type { PhotoCard } from '@/components/PhotoGrid.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  photos: PhotoCard[]
  count: number
  searchPosts: CollectionEntry<'blog'>[]
}

const { photos, count, searchPosts } = Astro.props
---

<ArchiveShell
  title="Photos"
  count={count}
  countLabel={count === 1 ? 'photo' : 'photos'}
  searchPosts={searchPosts}
  fromType="Photo"
  placeholder="Search photos…"
  class="reading--photos"
>
  <PhotoGrid photos={photos} />
</ArchiveShell>
